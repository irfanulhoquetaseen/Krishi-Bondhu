# Krishi Bondhu - API Keys Configuration
# Copy this file to backend/.env and populate your live API keys.

# Google Gemini API Key (Required for visual disease detection, agronomic reasoning, voice intake & Bengali advisory)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Required for real-time microclimate spray advisory)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Internal Gemini Model Identifier (Default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Gemini Native TTS Model Identifier (Default: gemini-2.5-flash-preview-tts)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: Gemini TTS Voice Preset (Default: Kore, Options: Kore, Puck, Charon, Fenrir, Aoede)
GEMINI_TTS_VOICE=Kore
